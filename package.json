{
  "name": "figrbx",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source Figma to Roblox Studio UI converter, with a Figma plugin and a Studio plugin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "pnpm -r --filter @figrbx/core --filter @figrbx/bridge run build && pnpm --filter @figrbx/figma-plugin run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @figrbx/core run test && pnpm --filter @figrbx/bridge run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:bridge": "pnpm --filter @figrbx/bridge run dev",
    "dev:plugin": "pnpm --filter @figrbx/figma-plugin run watch",
    "build:studio": "rojo build studio-plugin/default.project.json -o studio-plugin/figrbx.rbxm",
    "test:studio": "lune run tests/behaviors/generate.luau",
    "lint:luau": "selene studio-plugin/src"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3"
  },
  "homepage": "https://github.com/thynomex/figrbx#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thynomex/figrbx.git"
  },
  "bugs": {
    "url": "https://github.com/thynomex/figrbx/issues"
  },
  "keywords": [
    "figma",
    "roblox",
    "roblox-studio",
    "ui",
    "converter",
    "figma-plugin",
    "rojo",
    "luau"
  ]
}
